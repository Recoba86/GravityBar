{
  "name": "gravitybar",
  "displayName": "GravityBar — Antigravity Account Switcher",
  "description": "1-Click Google Account Switcher & Quota Monitor in Antigravity Status Bar",
  "version": "1.1.1",
  "publisher": "recoba86",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravitySwitcher.openMenu",
        "title": "GravityBar: Switch Antigravity Account / Usage",
        "icon": "$(account)"
      }
    ]
  }
}
